TIDB_URL=mysql+aiomysql://user:password@host:4000/solstice_events
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEND_API_KEY=re_your_key_here
RESEND_FROM=noreply@test.kigumotvc.ac.ke
# RESEND_TEST_TO — only needed on Resend free tier without a verified domain.
# Domain test.kigumotvc.ac.ke is verified, so this is disabled (leave empty).
RESEND_TEST_TO=
WEBHOOK_SECRET=change_me_to_a_random_secret
BADGE_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
# Cloudinary — used for QR code PNG storage only.
# Get from cloudinary.com → Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Cloudflare R2 — used for badge PDF storage (S3-compatible, no delivery restrictions).
# Create an R2 bucket and an API token with Object Read & Write permissions.
# R2_PUBLIC_URL_BASE: enable "Public access" on the bucket (or bind a custom domain).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=solstice-badges
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxxxxxx.r2.dev
