TIDB_URL=mysql+aiomysql://user:password@host:4000/solstice_events
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEND_API_KEY=re_your_key_here
RESEND_FROM=onboarding@resend.dev
# Resend free-tier workaround: redirect ALL emails to your verified address.
# Remove once you have a verified custom domain at resend.com/domains.
RESEND_TEST_TO=your_verified_email@gmail.com
WEBHOOK_SECRET=change_me_to_a_random_secret
BADGE_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
# Cloudinary — get from cloudinary.com → Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
